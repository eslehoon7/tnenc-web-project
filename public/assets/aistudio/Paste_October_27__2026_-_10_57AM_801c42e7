              >
                {item}
              </a>
            ))}
          </nav>

          <div className="hidden md:flex items-center gap-4">
            <a 
              href="#location" 
              className="px-5 py-2.5 rounded bg-[#e30613] hover:bg-red-700 text-white text-xs font-bold tracking-wider transition-all shadow-lg shadow-red-950 flex items-center gap-2"
            >
