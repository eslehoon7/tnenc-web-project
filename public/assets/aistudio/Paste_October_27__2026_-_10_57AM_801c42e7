      <header className={`fixed top-0 left-0 w-full z-50 transition-all duration-300 ${
        isScrolled ? 'bg-slate-950/95 shadow-xl backdrop-blur-md py-4 border-b border-slate-800' : 'bg-transparent py-6'
      }`}>
        <div className="max-w-7xl mx-auto px-6 flex items-center justify-between">
          <a href="#home" className="flex items-center gap-3">
            <div className="w-9 h-9 bg-[#e30613] rounded flex items-center justify-center font-black text-xl text-white tracking-tighter">
