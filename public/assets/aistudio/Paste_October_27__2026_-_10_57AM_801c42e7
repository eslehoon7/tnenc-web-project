import React, { useState, useEffect } from 'react';
import { 
  Building2, ShieldCheck, Award, Zap, ChevronRight, Phone, 
  Mail, MapPin, Printer, Menu, X, ArrowUpRight, CheckCircle2,
  Cpu, Layers, Compass, HardHat, FileSpreadsheet
} from 'lucide-react';

export default function App() {
  const [isScrolled, setIsScrolled] = useState(false);
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [activeFilter, setActiveFilter] = useState('all');

  useEffect(() => {
    const handleScroll = () => {
      setIsScrolled(window.scrollY > 40);
    };
    window.addEventListener('scroll', handleScroll);
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  // 프로젝트 데이터 (PDF 실적 기반)
  const projects = [
    {
      id: 1,
      client: "(주)삼양바이오팜",
      title: "유전자치료제 생산공장 신축공사",
      category: "bio",
      categoryName: "바이오 플랜트",
      scope: "주사제(Isolator type) / 시공",
      image: "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80"
    },
    {
      id: 2,
      client: "(주)유영제약",
      title: "진천 GMP공장 증축 및 리모델링",
      category: "bio",
      categoryName: "GMP 생산시설",
      scope: "원료의약품 생산동 / 시공",
      image: "https://images.unsplash.com/photo-1579165466791-788226ab77b6?auto=format&fit=crop&w=800&q=80"
    },
    {
      id: 3,
      client: "(사)한국동물약품협회",
      title: "기업연구원 구축공사",
      category: "rnd",
      categoryName: "R&D 연구시설",
      scope: "시험분석실 및 LAB / 설계+시공",
      image: "https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&w=800&q=80"
    },
    {
      id: 4,
      client: "(주)바이넥스",
      title: "오송공장 5K LINE 확장공사",
      category: "bio",
      categoryName: "바이오 플랜트",
      scope: "배양 및 정제시설 / 시공",
      image: "https://images.unsplash.com/photo-1581093458791-9d58946cc9f2?auto=format&fit=crop&w=800&q=80"
    },
    {
      id: 5,
      client: "(주)옵투스제약",
      title: "오송2공장 신축 토목·건축공사",
      category: "bio",
      categoryName: "점안제 특화공장",
      scope: "토목, 건축, 기계설비 / 시공",
      image: "https://images.unsplash.com/photo-1587854692152-cbe660dbde88?auto=format&fit=crop&w=800&q=80"
    },
    {
      id: 6,
      client: "(주)유진글로벌",
      title: "하남미사 사옥 신축공사",
      category: "general",
      categoryName: "일반건축",
      scope: "근린생활 및 업무시설 / 시공",
      image: "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=800&q=80"
    }
  ];

  const filteredProjects = activeFilter === 'all' 
    ? projects 
    : projects.filter(p => p.category === activeFilter);

